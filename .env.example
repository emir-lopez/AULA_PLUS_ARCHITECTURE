# Copiar a .env y ajustar. NO subir .env al repositorio (está en .gitignore).
# Valores de ejemplo, sin secretos reales.

# --- Aplicación ---
APP_ENV=development
# Local sin Docker usa SQLite. En docker compose DATABASE_URL apunta al servicio "db".
DATABASE_URL=sqlite:///./aulaplus.db
SEED_DEMO=true
# Solo demo: habilita la cabecera X-Fecha-Simulada. En producción real: false.
PERMITIR_FECHA_SIMULADA=true
APP_PORT=8000

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=aulaplus
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=aulaplus
DB_PORT=5432

# --- Parámetros de negocio (BRD, ADR-004) ---
MINUTOS_CONGELAMIENTO=10
HORAS_RETENCION=48
HORAS_MEDIACION=72
MINUTOS_TOLERANCIA_NO_SHOW=10
HORAS_ANTICIPACION_MINIMA=2
DIAS_VIGENCIA_AGENDA=7
MARCAS_PARA_SUSPENSION=3
MINUTOS_TOLERANCIA_CONEXION=15
MINUTOS_MAXIMOS_EXTENSION=60
